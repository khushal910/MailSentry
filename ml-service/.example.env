MONGODB_URI = ""
DATA_BASE_NAME = ""
COLLECTION_NAME = ""

MONGODB_URI_REAL_USER=
DATABASE_NAME_REAL_USER=
USER_COLLECTION_NAME_REAL_USER=
EMAIL_COLLECTION_NAME_REAL_USER=
MODEL_COLLECTION_NAME_REAL_USER=


DAGSHUB_USERNAME = ""
DAGSHUB_REPOSITORY = ""
EXPERIMENT_NAME = ""
ENABLE_FINE_TUNING=true
ENABLE_DISTILBERT=true
ENABLE_TABPFN=true

# Internal Service Key
ML_SERVICE_API_KEY=

# Classification model provider
# Supported values: mlops, otis, roberta, deberta-v3-base
CLASSIFICATION_MODEL=mlops

# ONNX Runtime Acceleration & INT8 Quantization (true/false)
USE_ONNX=false

# CORS Configuration

CORS_ORIGINS=["http://localhost:8000","http://127.0.0.1:8000","http://localhost:5173","http://127.0.0.1:5173","http://localhost:3000","http://127.0.0.1:3000"]
CORS_ORIGIN_REGEX=https://.*\.vercel\.app