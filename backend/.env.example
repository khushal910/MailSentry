# Server
APP_NAME=MailSentry
DEBUG=True
SECRET_KEY=your-secret-key-here  
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:3000","http://127.0.0.1:3000","http://localhost:8080","http://127.0.0.1:8080"]
    
# MongoDB
MONGO_URI=mongodb://localhost:27017
DATABASE_NAME=mailsentry
USER_COLLECTION_NAME=users
EMAIL_COLLECTION_NAME=emails
MODEL_COLLECTION_NAME=models

# Google OAuth
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/gmail/oauth/callback

# Independent ML Microservice API Configuration
ML_SERVICE_URL=http://localhost:9000
ML_SERVICE_TIMEOUT=30
ML_SERVICE_API_KEY=

# password 
PASSWORD_LENGTH = 2
PASSWORD_RULE_APPLY = False

# cookies
SECURE_COOKIES = False

# SMTP — fill in your credentials before using email features
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USE_TLS=True
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-password
EMAIL_FROM=your-email@gmail.com
EMAIL_FROM_NAME=MailSentry

# Google Account Collection Name
GOOGLE_ACCOUNT_COLLECTION_NAME=google_accounts

# Gmail fetch rate limit & batch settings
FETCH_RATE_LIMIT_SECONDS=300
FETCH_RATE_LIMIT_SECONDS_APPLY=True
FETCH_MAX_RESULTS=50

# ML Model Classification decision threshold (0.0 to 1.0, default 0.50)
CLASSIFICATION_THRESHOLD=0.50

# cokies
SECURE_COOKIES = False

# Gemini api
GEMINI_API_KEY = 

# Grouq api
GROQ_API_KEY = 
GROQ_MODEL =
LLM_PROVIDER = 

# Maintenance Mode Configuration
# Set MAINTENANCE_MODE=true to put the app into maintenance mode
MAINTENANCE_MODE=false
# Optional: ISO 8601 UTC timestamp for estimated maintenance completion time
MAINTENANCE_END=
# Optional: Allow admin users (or specified admin emails) to bypass maintenance
MAINTENANCE_ADMIN_BYPASS=false
# Optional: Comma-separated admin email whitelist for bypass during maintenance
MAINTENANCE_ADMIN_EMAILS=